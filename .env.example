# ===========================================
# Sadary LLM Hub / Rodeo — Configuration
# ===========================================
# Tokens: FREE with Ollama | Paid with Moonshot API
# ===========================================

# LLM Provider: "ollama" (self-hosted) or "moonshot" (API)
LLM_PROVIDER=ollama

# Ollama URL
# - Local dev:    http://localhost:11434/v1
# - Docker/VPS:   http://ollama:11434/v1
# - Remote GPU:   https://llm.yourdomain.com/v1 (via Cloudflare Tunnel)
OLLAMA_URL=http://localhost:11434/v1

# Default model
DEFAULT_MODEL=qwen2.5:7b

# Deployment: "local" | "docker" | "vps"
# DEPLOYMENT_MODE=local

# Session secret (openssl rand -hex 32)
SESSION_SECRET=your-secret-here

# Database
DATABASE_URL=file:./llmhub.db

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token
DOMAIN=llm.sadary.xyz

# ===========================================
# Moonshot API (optional fallback)
# kimi-k2.5, kimi-k2-0905, kimi-k2-thinking
# ===========================================
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# DeepSeek API (optional - code specialist, very low cost)
# deepseek-chat, deepseek-reasoner, deepseek-coder
# ===========================================
# DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# VPS / GPU
# ===========================================
# On VPS with GPU: docker compose up (Ollama uses NVIDIA runtime)
# Heavier models: qwen2.5:72b, llama3.3:70b need 48GB VRAM
# Vision: llava:13b, llava-llama3:8b for images/video frames
# Concurrency: OLLAMA_NUM_PARALLEL=2 in docker-compose
# Pull after start: docker compose exec ollama ollama pull qwen2.5:72b
# ===========================================
