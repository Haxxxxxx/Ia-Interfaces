# ===========================================
# Sadary LLM Hub — Self-Hosted Configuration
# ===========================================
# Tokens: FREE | Pay only: GPU/VPS
# ===========================================

# LLM Provider: "ollama" (self-hosted, FREE) or "moonshot" (API, paid)
LLM_PROVIDER=ollama

# Ollama URL (self-hosted)
OLLAMA_URL=http://ollama:11434/v1

# Default model to use
DEFAULT_MODEL=qwen2.5:72b

# Session secret (generate with: openssl rand -hex 32)
SESSION_SECRET=your-secret-here

# Database
DATABASE_URL=file:/data/llmhub.db

# Cloudflare Tunnel (optional)
CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# Domain
DOMAIN=llm.sadary.xyz

# ===========================================
# Optional: Moonshot API (paid fallback)
# Only needed if LLM_PROVIDER=moonshot
# ===========================================
# MOONSHOT_API_KEY=sk-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ===========================================
# GPU Cloud Options (for self-hosted):
# ===========================================
# RunPod:   ~$0.50-2/hr for A100 → ~$360-1440/mo
# Vast.ai:  ~$0.30-1/hr for A100 → ~$216-720/mo
# Lambda:   ~$1.10/hr for A100   → ~$792/mo
# Shadow:   ~$30-50/mo (RTX 4090, consumer)
#
# Recommended: Vast.ai or RunPod for best $/performance
# ===========================================
