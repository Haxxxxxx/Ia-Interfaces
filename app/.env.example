# =============================================================================
# Sadary LLM Hub - Environment Configuration
# =============================================================================
# Copy this file to .env and fill in your values

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL=file:./data/llmhub.db

# -----------------------------------------------------------------------------
# LLM Providers
# -----------------------------------------------------------------------------

# Ollama (Self-hosted, FREE) - Primary for local models
# Use OLLAMA_URL (with /v1) or OLLAMA_BASE_URL
OLLAMA_URL=http://localhost:11434/v1

# DeepSeek API (OPTIONAL - Skip if using local models only)
# Get your API key from: https://platform.deepseek.com
# Cost: ~€0.14/1M tokens - only needed if local models aren't enough
# DEEPSEEK_API_KEY=sk-your-deepseek-api-key-here

# Moonshot API (OPTIONAL - Skip for budget setups)
# MOONSHOT_API_KEY=sk-your-moonshot-api-key-here

# -----------------------------------------------------------------------------
# Default Settings
# -----------------------------------------------------------------------------

# Default model to use (all FREE via Ollama)
# Best for code: qwen2.5-coder:14b
# Fast chat: qwen2.5:7b
# Ultra-fast: llama3.2:3b
DEFAULT_MODEL=qwen2.5-coder:14b

# App environment
NODE_ENV=production
PORT=3000

# -----------------------------------------------------------------------------
# Rate Limiting & Budgets
# -----------------------------------------------------------------------------

# Default monthly budget per user (in EUR) - only applies to paid APIs
# Set low to avoid surprises - DeepSeek is cheap anyway
DEFAULT_MONTHLY_BUDGET_EUR=20.0

# Requests per minute limit per user
DEFAULT_RPM_LIMIT=60

# Maximum context tokens allowed
MAX_CONTEXT_TOKENS=128000

# -----------------------------------------------------------------------------
# Security
# -----------------------------------------------------------------------------

# Session secret for auth (generate with: openssl rand -base64 32)
SESSION_SECRET=change-this-to-a-random-string

# -----------------------------------------------------------------------------
# Cloudflare Tunnel (Optional)
# -----------------------------------------------------------------------------
# CLOUDFLARE_TUNNEL_TOKEN=your-tunnel-token

# -----------------------------------------------------------------------------
# Domain (for documentation only)
# -----------------------------------------------------------------------------
# DOMAIN=llm.yourdomain.com
