{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sadary Hub",
  "version": "1.0.0",
  "identifier": "xyz.sadary.hub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sadary Hub",
        "width": 1200,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true,
      "scope": [
        {
          "name": "run-shell",
          "cmd": "sh",
          "args": ["-c", { "validator": ".*" }]
        }
      ]
    },
    "fs": {
      "scope": ["$HOME/**", "$DOCUMENT/**", "$DESKTOP/**"]
    }
  }
}
