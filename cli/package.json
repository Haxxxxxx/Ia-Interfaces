{
  "name": "@rodeo/cli",
  "version": "1.0.0",
  "description": "Rodeo - AI coding assistant CLI with Shadow cloud GPU support",
  "bin": {
    "rodeo": "./dist/rodeo.js",
    "rodeo-shadow-setup": "./scripts/shadow-vps-setup.sh",
    "rodeo-connect": "./scripts/connect-shadow.sh",
    "rodeo-models": "./scripts/install-models.sh"
  },
  "main": "./dist/rodeo.js",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev": "tsx rodeo.ts",
    "start": "node dist/rodeo.js",
    "shadow:setup": "./scripts/shadow-vps-setup.sh",
    "shadow:connect": "./scripts/connect-shadow.sh",
    "models:install": "./scripts/install-models.sh",
    "prepublishOnly": "npm run build"
  },
  "files": [
    "dist",
    "scripts",
    "README.md",
    "SHADOW-SETUP.md"
  ],
  "dependencies": {
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@typescript-eslint/eslint-plugin": "^8.54.0",
    "@typescript-eslint/parser": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.4.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "ai",
    "coding",
    "assistant",
    "cli",
    "llm",
    "ollama",
    "claude",
    "gpu",
    "shadow",
    "cloud",
    "nvidia",
    "cuda"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/your-org/rodeo"
  },
  "license": "MIT"
}
